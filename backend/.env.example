# Copy to .env and fill in to use real Claude generation.
# Without a key the system runs in deterministic "mock" mode (still fully functional).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Embeddings: "huggingface" (real, downloads a small model) or "hash" (offline fallback)
EMBEDDING_BACKEND=huggingface

# RAG tuning
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
